# Ollama settings (LocalRAG)
OLLAMA_BASE=http://localhost:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=gemma3:27b

# LM Studio settings (Council / Wisemen)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=openai/gpt-oss-120b

# Storage
CHROMA_DIR=./rag_db
OUTPUT_DIR=./output

# Watch folder for nightly reindex (optional)
WATCH_FOLDER=

# Obsidian vault path (for Docker volume mount)
OBSIDIAN_PATH=

# UI Language: ja or en
LANG_UI=ja

# Anthropic API Key (LocalRAG Web検索機能で使用)
ANTHROPIC_API_KEY=
